PORT=5000

# Gmail SMTP Configuration
# Use your actual @gmail.com address for EMAIL_USER
# For EMAIL_PASSWORD, DO NOT use your normal Gmail password.
# You must generate an "App Password" from your Google Account settings:
# (Manage Google Account -> Security -> 2-Step Verification -> App Passwords)

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
